    "_postman_id": "5a1205b4-f0b2-4d6b-903e-fa9a5ffcd923",
    "name": "USDA NRCS Soil Data Access Query SOAP API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "OpenAPI description of the USDA Natural Resources Conservation Service Soil Data Access (SDA) web services. SDA exposes a public REST POST endpoint that accepts SQL queries against the Soil Data Mart database and returns tabular data in XML, JSON or plain text. SDA additionally provides SOAP, WFS and WMS endpoints which are referenced here but not fully modeled in this specification. The REST endpoint is open and does not require authentication.\n\nContact Support:\n Name: API Evangelist\n Email: kin@apievangelist.com",
      "type": "text/plain"
    }
